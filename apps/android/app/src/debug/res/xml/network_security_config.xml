<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds (this replaces main's): plain HTTP to the Mac's loopback as the Android emulator
     sees it (10.0.2.2: the local Firebase emulators and the dev server), and to the device's own
     loopback, where a cover or story picture stored against the emulators is
     (http://localhost:<dev port>/api/emulator-storage/…, reached through
     `adb reverse tcp:<dev port> tcp:<dev port>`; apps/README.md). -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
