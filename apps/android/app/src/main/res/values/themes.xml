<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Resonance</string>
    <!--
      The paper color while the first frame draws (the color-cream token), and the system bars as
      MainActivity's enableEdgeToEdge sets them: see-through, dark glyphs, no contrast scrim. Said here
      too because on Android 12 and 12L the splash, as it hands off, copies this theme's bar colors
      onto the window — Theme.Material's grey and black bands, had it none of its own. Dark mode's
      twin (the night paper, light glyphs) is values-night/themes.xml.
    -->
    <style name="Theme.Resonance" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <!-- The system's own controls (the writer WebView's selection handles) in the accent, not Material's teal; a theme's own: ThemeOverlay.Resonance.* below. -->
        <item name="android:colorAccent">@color/accent_terracotta</item>
        <item name="android:colorControlActivated">@color/accent_terracotta</item>
    </style>

    <!--
      外觀's theme laid over Theme.Resonance (MainActivity applies the chosen one): the accent the
      system draws its controls in. The resolved colours follow the scheme (values-night).
    -->
    <style name="ThemeOverlay.Resonance.Terracotta" parent="">
        <item name="android:colorAccent">@color/accent_terracotta</item>
        <item name="android:colorControlActivated">@color/accent_terracotta</item>
    </style>
    <style name="ThemeOverlay.Resonance.Sage" parent="">
        <item name="android:colorAccent">@color/accent_sage</item>
        <item name="android:colorControlActivated">@color/accent_sage</item>
    </style>
    <style name="ThemeOverlay.Resonance.Lavender" parent="">
        <item name="android:colorAccent">@color/accent_lavender</item>
        <item name="android:colorControlActivated">@color/accent_lavender</item>
    </style>
    <style name="ThemeOverlay.Resonance.Yellow" parent="">
        <item name="android:colorAccent">@color/accent_yellow</item>
        <item name="android:colorControlActivated">@color/accent_yellow</item>
    </style>
    <style name="ThemeOverlay.Resonance.Wallpaper" parent="">
        <item name="android:colorAccent">@color/accent_wallpaper</item>
        <item name="android:colorControlActivated">@color/accent_wallpaper</item>
    </style>

    <!--
      The launch (androidx SplashScreen; Android 12's own splash, and its backport on 10–11): the
      launcher icon's waves on the paper, then Theme.Resonance. In dark mode the night paper with
      light bar glyphs (values-night) — the system's mode, or on Android 12+ the app's own
      (AppearanceStore sets the app's night mode, which the next launch's splash follows).
      The hand-off into the first screen is MainActivity's (Launch.kt).
    -->
    <style name="Base.Theme.Resonance.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/paper</item>
        <!-- The launcher's foreground as it is: on the splash's 108-unit canvas the waves sit inside the 2/3 circle the system keeps. -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Resonance</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
    <style name="Theme.Resonance.Starting" parent="Base.Theme.Resonance.Starting" />

    <!--
      The launch in 外觀's theme (Android 13+: AppearanceStore hands the system the chosen one for the
      next launch, SplashScreen.setSplashScreenTheme): that theme's paper, light or night (values-night),
      the icon as it is. 桌布配色 takes the system's own neutral paper.
    -->
    <style name="Theme.Resonance.Starting.Sage">
        <item name="windowSplashScreenBackground">@color/paper_sage</item>
    </style>
    <style name="Theme.Resonance.Starting.Lavender">
        <item name="windowSplashScreenBackground">@color/paper_lavender</item>
    </style>
    <style name="Theme.Resonance.Starting.Yellow">
        <item name="windowSplashScreenBackground">@color/paper_yellow</item>
    </style>
    <style name="Theme.Resonance.Starting.Wallpaper">
        <item name="windowSplashScreenBackground">@color/paper_wallpaper</item>
    </style>
</resources>
