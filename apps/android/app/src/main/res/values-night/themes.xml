<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Dark mode (the system's, or the app's own on Android 12+, AppearanceStore): Theme.Resonance
      and the launch on the night paper, the bars' glyphs light. The screens draw their own colours
      (ResonanceTheme); this is what shows before the first frame and as the splash hands off.
    -->
    <style name="Theme.Resonance" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
    </style>

    <style name="Base.Theme.Resonance.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/paper</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Resonance</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
