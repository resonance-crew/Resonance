NEXT_PUBLIC_ENABLE_PHONE_OTP=false
# Sign in with Apple on the web: turn on once Firebase's Apple provider has a Services ID and a key
NEXT_PUBLIC_ENABLE_APPLE_SIGNIN=false

# The Meta (Facebook) App ID, public: with it the web share menu's Facebook row opens Facebook's
# documented Share Dialog (dialog/share?app_id=…), without it the older sharer.php. Production's is
# set on Vercel; resonance.channel must be in the Meta app's App Domains. Leave empty locally.
NEXT_PUBLIC_META_APP_ID=

# Canonical site origin for Open Graph / Twitter share links + the PWA manifest.
# Set this to your production domain when you have one. If unset, production
# falls back to Vercel's VERCEL_PROJECT_PRODUCTION_URL, and local dev to
# http://localhost:3000. No trailing slash.
NEXT_PUBLIC_SITE_URL=

# The Meta (Facebook) app id: card and profile pages name it as fb:app_id (and
# the web's Facebook share row uses the documented share dialog with it).
NEXT_PUBLIC_META_APP_ID=

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SESSION_COOKIE_NAME=__session
FIREBASE_SESSION_EXPIRES_IN_DAYS=7

R2_ACCOUNT_ID=
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_API_TOKEN=
R2_PUBLIC_BASE=
# Earlier public bases of the same bucket, comma-separated, while pictures stored
# before a move to a new host still name them (both hosts serve every key). Their
# pictures stay "ours"; `npx tsx scripts/backfill.ts rehost-images` moves the URLs.
R2_FORMER_PUBLIC_BASES=
# Pictures sent in chat: a bucket of their own with no public address (read only through
# /api/v1/chat-images/{id}). Its own keys are optional — unset, the R2 keys above must reach it.
# Unset against the emulators, pictures go to a folder on this machine (EMULATOR_CHAT_IMAGES_DIR,
# else one in the temp dir); unset in production, pictures can't be sent.
R2_CHAT_BUCKET=
R2_CHAT_ACCESS_KEY_ID=
R2_CHAT_SECRET_ACCESS_KEY=

# Signs the pictures of chat link previews (/api/link-image), and keys the version in a drawn
# card's share-image URL (/api/og/card). Optional: unset, both keys are derived from
# FIREBASE_PRIVATE_KEY. Changing it makes the pictures of existing previews 404 (drawn cards'
# old URLs are sent on to the new).
LINK_PREVIEW_SECRET=

# OpenAI — slug translation (LLM) + story image generation (Image model)
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-5.4-mini-2026-03-17
OPENAI_IMAGE_MODEL=gpt-image-2

# Recommendation engine (all optional — sensible defaults shown).
# Write-time: embeds the insight signature; read-time: cheap batch rerank.
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_RERANK_MODEL=gpt-5.4-mini-2026-03-17
# Vector backend behind the IVectorStore abstraction (firestore | future: vectorize).
RECO_VECTOR_BACKEND=firestore
