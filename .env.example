NEXT_PUBLIC_ENABLE_PHONE_OTP=false
# Sign in with Apple on the web: turn on once Firebase's Apple provider has a Services ID and a key
NEXT_PUBLIC_ENABLE_APPLE_SIGNIN=false

# The Meta (Facebook) App ID, public: with it the web share menu's Facebook row opens Facebook's
# documented Share Dialog (dialog/share?app_id=…), without it the older sharer.php. Production's is
# set on Vercel; resonance.channel must be in the Meta app's App Domains. Leave empty locally.
NEXT_PUBLIC_META_APP_ID=

# Canonical site origin for Open Graph / Twitter share links + the PWA manifest.
# Set this to your production domain when you have one. If unset, production
# falls back to Vercel's VERCEL_PROJECT_PRODUCTION_URL, and local dev to
# http://localhost:3000. No trailing slash.
NEXT_PUBLIC_SITE_URL=

# The Meta (Facebook) app id: card and profile pages name it as fb:app_id (and
# the web's Facebook share row uses the documented share dialog with it).
NEXT_PUBLIC_META_APP_ID=

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SESSION_COOKIE_NAME=__session
FIREBASE_SESSION_EXPIRES_IN_DAYS=7

R2_ACCOUNT_ID=
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_API_TOKEN=
R2_PUBLIC_BASE=
# Earlier public bases of the same bucket, comma-separated, while pictures stored
# before a move to a new host still name them (both hosts serve every key). Their
# pictures stay "ours"; `npx tsx scripts/backfill.ts rehost-images` moves the URLs.
R2_FORMER_PUBLIC_BASES=
# Pictures sent in chat: a bucket of their own with no public address (read only through
# /api/v1/chat-images/{id}). Its own keys are optional — unset, the R2 keys above must reach it.
# Unset against the emulators, pictures go to a folder on this machine (EMULATOR_CHAT_IMAGES_DIR,
# else one in the temp dir); unset in production, pictures can't be sent.
R2_CHAT_BUCKET=
R2_CHAT_ACCESS_KEY_ID=
R2_CHAT_SECRET_ACCESS_KEY=

# Signs the pictures of chat link previews (/api/link-image), and keys the version in a drawn
# card's share-image URL (/api/og/card). Unset, both keys are derived from FIREBASE_PRIVATE_KEY
# (production logs a warning once: rotating the service account would orphan stored pictures).
# To pin today's keys, set it to what `npx tsx scripts/ops/link-preview-secret.ts` prints
# (`derived-v1:…`). Changing it makes the pictures of existing previews 404 (drawn cards' old
# URLs are sent on to the new).
LINK_PREVIEW_SECRET=

# OpenAI — slug translation (LLM) + story image generation (Image model)
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-5.4-mini-2026-03-17
OPENAI_IMAGE_MODEL=gpt-image-2

# Recommendation engine (all optional — sensible defaults shown).
# Write-time: embeds the insight signature; read-time: cheap batch rerank.
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_RERANK_MODEL=gpt-5.4-mini-2026-03-17
# Vector backend behind the IVectorStore abstraction (firestore | future: vectorize).
RECO_VECTOR_BACKEND=firestore

# The apps' launch config (GET /api/v1/client-config, src/server/domain/clientConfig.ts) — all
# optional; unset, no build must update and the default flags hold. Builds below CLIENT_MIN_BUILD_*
# (iOS CFBundleVersion, Android versionCode) show the update screen; below CLIENT_RECOMMENDED_BUILD_*
# they are told an update is waiting. A malformed number reads as 0 (it never locks anyone out).
CLIENT_MIN_BUILD_IOS=
CLIENT_MIN_BUILD_ANDROID=
CLIENT_RECOMMENDED_BUILD_IOS=
CLIENT_RECOMMENDED_BUILD_ANDROID=
# A JSON object laid over the default flags {"signals":true,"apiSocial":true,"apiInbox":true,
# "apiBell":true,"apiThoughtMap":false,"apiDrafts":false}: the server's rollback for the apps'
# Phase 2 paths, e.g. {"apiInbox":false} sends every app build back to its Firestore inbox.
CLIENT_FEATURES=

# --- Phase 3 sessions (ADR 0004): Resonance's own access/refresh tokens ---
# A JSON list of EC P-256 keys (ES256), the current one first (it signs), then the previous
# ones (public only: they still verify for one access token's 15 minutes after a rotation):
# [{"kid":"2026-11-ab12","jwk":{"kty":"EC","crv":"P-256","x":"…","y":"…","d":"…"}}, …].
# Make one with `npx tsx scripts/auth/jwtKey.ts` (`--rotate "$CURRENT"` to rotate). Unset, the
# feature is off: POST /api/v1/auth/exchange answers 503 and only Firebase tokens sign anyone in.
RESONANCE_JWT_KEYS=
