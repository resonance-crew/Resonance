<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The Mac captures' Debug build (com.resonance.stories.macdev, mac.ts): what a development profile
     signs without App Store services — the sandbox, the network, and the keychain Firebase Auth keeps
     its session in (apps/README.md, The Mac app). -->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.resonance.stories.macdev</string>
	</array>
</dict>
</plist>
